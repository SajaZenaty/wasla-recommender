# ---- Auth & Express integration ----
# Shared secret required on /sync/* and /recommend (sent as X-Internal-Token).
# Leave empty to disable auth (development only).
RECOMMENDER_API_KEY=change-me

# Base URL of your Express backend (reachable from this container).
# Export endpoint: GET {EXPRESS_INTERNAL_URL}/internal/recommender-export
EXPRESS_INTERNAL_URL=http://express:3000
EXPRESS_TIMEOUT_MS=30000

# ---- Startup / data source ----
# On start: try snapshot (if usable), then Express pull, then mock data.
BOOTSTRAP_ON_START=true
USE_MOCK_DATA=false
MOCK_N_USERS=50

# ---- Snapshot persistence ----
# Use a mounted volume in production so cold starts do not depend on Express.
INDEX_SNAPSHOT_PATH=/data/index_snapshot.pkl

# ---- Scheduler (nightly full rebuild from Express) ----
ENABLE_SCHEDULER=true
NIGHTLY_REBUILD_CRON=0 3 * * *

# ---- Serving limits ----
MAX_TOP_K=50
DEFAULT_TOP_K=10

# ---- Model & tuning (optional overrides) ----
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# SCORING_WEIGHT_SEMANTIC=0.35
# SCORING_WEIGHT_RETRIEVAL=0.15
# SCORING_WEIGHT_CF=0.15

LOG_LEVEL=INFO

# ---- After deploy (smoke test) ----
# RECOMMENDER_URL=http://localhost:8000 ./scripts/verify_deploy.sh
# EXPRESS_INTERNAL_URL=... RECOMMENDER_API_KEY=... python scripts/verify_express_export.py
# curl -X POST $RECOMMENDER_URL/sync/bootstrap -H "X-Internal-Token: $RECOMMENDER_API_KEY"
