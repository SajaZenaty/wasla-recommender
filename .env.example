# ---- Auth & Express integration ----
# Shared secret required on /sync/* and /recommend (sent as X-Internal-Token).
# Leave empty to disable auth (development only).
RECOMMENDER_API_KEY=change-me

# Base URL of your Express backend's internal export endpoint.
EXPRESS_INTERNAL_URL=http://express:3000
EXPRESS_TIMEOUT_MS=5000

# ---- Startup / data source ----
# On start: try snapshot, then mock data (if enabled), then Express pull.
BOOTSTRAP_ON_START=true
USE_MOCK_DATA=false
MOCK_N_USERS=50

# ---- Snapshot persistence ----
INDEX_SNAPSHOT_PATH=/data/index_snapshot.pkl

# ---- Scheduler (nightly full rebuild from Express) ----
ENABLE_SCHEDULER=true
NIGHTLY_REBUILD_CRON=0 3 * * *

# ---- Serving limits ----
MAX_TOP_K=50
DEFAULT_TOP_K=10

# ---- Model & tuning (optional overrides) ----
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# SCORING_WEIGHT_SEMANTIC=0.35
# SCORING_WEIGHT_RETRIEVAL=0.15
# SCORING_WEIGHT_CF=0.15

LOG_LEVEL=INFO
